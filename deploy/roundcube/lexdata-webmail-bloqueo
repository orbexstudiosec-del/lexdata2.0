#!/usr/bin/env bash
# Bloqueo de IPs solo en el webmail (correo.lexdata.com.ec). Lo usa fail2ban (acción caddy-webmail):
# en lugar de cortar toda la conexión con el servidor, Caddy responde «demasiados intentos»
# únicamente en el webmail; el resto de las páginas siguen abriendo.
#   lexdata-webmail-bloqueo add <ip> | del <ip> | flush | lista
set -euo pipefail

LISTA=/var/lib/lexdata/webmail-bloqueados.txt
SNIPPET=/etc/caddy/webmail-bloqueados.caddy
mkdir -p "$(dirname "$LISTA")"
touch "$LISTA"

ip_valida() { [[ "$1" =~ ^[0-9a-fA-F:.]+(/[0-9]+)?$ ]]; }

case "${1:-}" in
  add) ip_valida "${2:-}" && { grep -qxF "$2" "$LISTA" || echo "$2" >>"$LISTA"; } ;;
  del) ip_valida "${2:-}" && { grep -vxF "$2" "$LISTA" >"$LISTA.tmp" || true; mv "$LISTA.tmp" "$LISTA"; } ;;
  flush) : >"$LISTA" ;;
  lista) cat "$LISTA"; exit 0 ;;
  *) echo "Uso: $0 add <ip> | del <ip> | flush | lista" >&2; exit 1 ;;
esac

ips=$(sort -u "$LISTA" | tr '\n' ' ' | sed 's/ $//')
{
  echo "# Generado por lexdata-webmail-bloqueo: no editar a mano."
  if [ -n "$ips" ]; then
    echo "@bloqueado_webmail remote_ip $ips"
    echo "respond @bloqueado_webmail \"Demasiados intentos fallidos. Vuelva a intentarlo en una hora.\" 429"
  fi
} >"$SNIPPET.tmp"
# fail2ban ejecuta esto con umask 077: Caddy (usuario caddy) tiene que poder leerlo.
chmod 644 "$SNIPPET.tmp"
mv "$SNIPPET.tmp" "$SNIPPET"
systemctl reload caddy
