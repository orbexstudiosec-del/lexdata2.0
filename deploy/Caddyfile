{
	email informacion@lexdata.com.ec
}

lexdata.com.ec {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

www.lexdata.com.ec {
	redir https://lexdata.com.ec{uri} permanent
}

# Acceso por IP mientras el dominio apunta al hosting anterior.
http://2.31.79.129 {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

(roundcube) {
	# IPs bloqueadas por intentos fallidos (fail2ban → lexdata-webmail-bloqueo): solo en el webmail.
	import /etc/caddy/webmail-bloqueados.caddy
	root * /srv/roundcube/public_html
	encode zstd gzip
	php_fastcgi unix//run/php/php8.5-fpm.sock
	file_server
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=63072000"
		-Server
	}
}

# Webmail (Roundcube) del servidor de correo de este VPS.
correo.lexdata.com.ec {
	import roundcube
}

# Nombre del servidor de correo (MX, IMAP, SMTP). Caddy obtiene su certificado,
# que lexdata-mail-certs copia para Postfix y Dovecot. En el navegador lleva al webmail.
mail.lexdata.com.ec, webmail.lexdata.com.ec {
	redir https://correo.lexdata.com.ec permanent
}

# Plataforma de protección de datos (proyecto Lexdata-PDP), Next.js en el puerto 3001.
protecciondedatos.lexdata.com.ec {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy 127.0.0.1:3001
	header -Server
}

# MTA-STS: política que pide a los demás servidores entregar el correo a mail.lexdata.com.ec solo cifrado.
# Modo «testing»: informa de problemas sin rechazar correo. Pasar a «enforce» cuando los informes estén limpios.
mta-sts.lexdata.com.ec {
	header /.well-known/mta-sts.txt Content-Type "text/plain; charset=utf-8"
	respond /.well-known/mta-sts.txt `version: STSv1
mode: testing
mx: mail.lexdata.com.ec
max_age: 604800
` 200
	respond 404
}
