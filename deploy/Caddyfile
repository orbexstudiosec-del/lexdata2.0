{
	email informacion@lexdata.com.ec
}

lexdata.com.ec {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

www.lexdata.com.ec {
	redir https://lexdata.com.ec{uri} permanent
}

# Acceso por IP mientras el dominio apunta al hosting anterior.
http://2.31.79.129 {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

(roundcube) {
	root * /srv/roundcube/public_html
	encode zstd gzip
	php_fastcgi unix//run/php/php8.5-fpm.sock
	file_server
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=63072000"
		-Server
	}
}

# Webmail (Roundcube) del servidor de correo de este VPS.
correo.lexdata.com.ec {
	import roundcube
}

# Nombre del servidor de correo (MX, IMAP, SMTP). Caddy obtiene su certificado,
# que lexdata-mail-certs copia para Postfix y Dovecot. En el navegador lleva al webmail.
mail.lexdata.com.ec, webmail.lexdata.com.ec {
	redir https://correo.lexdata.com.ec permanent
}

# Plataforma de protección de datos (proyecto Lexdata-PDP), Next.js en el puerto 3001.
protecciondedatos.lexdata.com.ec {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy 127.0.0.1:3001
	header -Server
}
